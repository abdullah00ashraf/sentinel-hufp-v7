# Sentinel V7.0 Environmental Configuration Template
# Copy this file to .env and configure for local or cloud deployment.

# Tactical API Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Database Configuration
SQLITE_DB_PATH=tactical_db/sentinel_v7_tactical.db

# Open-Meteo Environmental & Flood Engine Endpoints
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
FLOOD_API_URL=https://flood-api.open-meteo.com/v1/flood

# Optional: Hugging Face Space Authentication Token (Only for pushing updates to HF space)
# HUGGINGFACE_TOKEN=your_hf_token_here
